{
  "name": "tuturai-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "emulators": "pnpm dlx firebase-tools@latest emulators:start --only auth,firestore --project demo-tuturai",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "test:e2e:speaking": "node apps/web/scripts/e2e-speaking-assessment.mjs",
    "test:e2e:assignment": "node apps/web/scripts/e2e-assignment-lifecycle.mjs",
    "test:e2e:teacher-analytics": "node apps/web/scripts/e2e-teacher-analytics-report.mjs",
    "test:e2e:offline": "node apps/web/scripts/e2e-offline-sync.mjs",
    "e2e:prod:config:test": "node --test apps/web/scripts/e2e-prod-config.test.mjs apps/web/scripts/e2e-prod-runner.test.mjs",
    "e2e:prod:smoke": "node apps/web/scripts/e2e-prod.mjs smoke",
    "e2e:prod:auth": "node apps/web/scripts/e2e-prod.mjs auth",
    "e2e:prod:student": "node apps/web/scripts/e2e-prod.mjs student",
    "e2e:prod:teacher": "node apps/web/scripts/e2e-prod.mjs teacher",
    "e2e:prod:classroom": "node apps/web/scripts/e2e-prod.mjs classroom",
    "e2e:prod:assignment": "node apps/web/scripts/e2e-prod.mjs assignment",
    "e2e:prod:drive": "node apps/web/scripts/e2e-prod.mjs drive",
    "e2e:prod:speaking": "node apps/web/scripts/e2e-prod.mjs speaking",
    "e2e:prod:pronunciation": "node apps/web/scripts/e2e-prod.mjs pronunciation",
    "e2e:prod:voice": "node apps/web/scripts/e2e-prod.mjs voice",
    "e2e:prod:offline": "node apps/web/scripts/e2e-prod.mjs offline",
    "e2e:prod:security": "node apps/web/scripts/e2e-prod.mjs security",
    "e2e:prod:all": "node apps/web/scripts/e2e-prod.mjs all",
    "secrets:login": "infisical login",
    "secrets:login:headless": "infisical login -i",
    "secrets:init": "infisical init",
    "secrets:run": "infisical run --env=dev --",
    "secrets:scan": "infisical scan .",
    "dev:secrets": "infisical run --env=dev -- turbo run dev"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "turbo": "2.11.2"
  }
}
