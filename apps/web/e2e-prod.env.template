# Copy this file to apps/web/.env.e2e.production for the production Playwright runner.
# That runner loads only this file; it never reads .env.local.
# Do not use apps/web/.env.local: it targets demo-tuturai and Firebase emulators.
# Never commit real test passwords, service-account keys, or provider credentials.

E2E_BASE_URL=https://tuturai-apps.netlify.app
E2E_ALLOW_CUSTOM_NETLIFY_HOST=false
E2E_FIREBASE_PROJECT_ID=gen-lang-client-0138449759
E2E_FIREBASE_ADMIN_PROJECT_ID=gen-lang-client-0138449759
E2E_FIREBASE_ADMIN_CLIENT_EMAIL=
E2E_FIREBASE_ADMIN_PRIVATE_KEY=

# Pre-created, dedicated production E2E accounts. Verify these identities before
# setting E2E_TEST_DATA_APPROVED=true.
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_STUDENT_UID=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_TEACHER_UID=
E2E_FOREIGN_TEACHER_EMAIL=
E2E_FOREIGN_TEACHER_PASSWORD=
E2E_FOREIGN_TEACHER_UID=
E2E_TEST_PREFIX=e2e-prod-20260926
E2E_TEST_DATA_APPROVED=false
E2E_CLEANUP_AFTER_RUN=true
E2E_HEADLESS=false

# Google auth pauses for a human browser login and resumes assertions afterward.
E2E_GOOGLE_AUTH_ENABLED=false
E2E_GOOGLE_AUTH_EMAIL=
E2E_GOOGLE_AUTH_ROLE=student
E2E_GOOGLE_AUTH_TEST_ACCOUNT_APPROVED=false

# Existing, dedicated classroom fixtures used by scoped E2E suites.
E2E_CLASSROOM_ID=
# Foreign class must belong to another teacher; for voice isolation the student
# E2E account must also be an active member of this class.
E2E_FOREIGN_CLASSROOM_ID=
E2E_REVOKED_JOIN_CLASSROOM_ID=
E2E_REVOKED_JOIN_KEY=

# Set true only after the actual provider has been configured for production.
E2E_DRIVE_ENABLED=false
# Dedicated Google account whose Drive is used only for production E2E. Verify
# the selected account during the human consent checkpoint before approving it.
E2E_DRIVE_ACCOUNT_EMAIL=
E2E_DRIVE_ACCOUNT_APPROVED=false
E2E_DRIVE_TEST_FILE=
E2E_AI_ENABLED=false
E2E_AUDIO_FIXTURE_PATH=
E2E_EXPECTED_TEXT=
E2E_PRONUNCIATION_ENABLED=false
E2E_VOICE_ENABLED=false
E2E_VOICE_AUDIO_FIXTURE=
E2E_VOICE_REFERENCE_TEXT=
E2E_OFFLINE_ENABLED=false
