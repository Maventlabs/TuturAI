# Public Firebase web configuration. These values are safe to expose in the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Test-only emulator hosts. Leave empty for cloud Firebase.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=

# Server-only Firebase Admin credentials. Never expose these to client code.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Shared Google OAuth web-client configuration.
# Firebase Google Sign-In uses the Firebase provider configuration; do not add a
# second Google client key for login. Reuse this OAuth client for Drive OAuth
# and any future server-side Google OAuth callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Server-only AI provider configuration. Never expose these to client code.
# AI_LOCAL_BASE_URL is shared by the self-hosted STT (whisper.cpp) and the
# self-hosted OmniVoice/TTS. Leave it empty until that service is running; an
# empty value is not a credential blocker and must not be treated as success.
AI_LOCAL_BASE_URL=
# Recommended when the tunnel/provider requires bearer authentication.
AI_LOCAL_API_KEY=
AI_V1_BASE_URL=
AI_V1_API_KEY=

# Select the server independently for each capability.
# AI_STT_ROUTE=local points STT at the self-hosted whisper.cpp server
# (AI_LOCAL_BASE_URL); =v1 uses the hosted Whisper endpoint (AI_V1_BASE_URL).
# Both talk the same OpenAI-compatible multipart /audio/transcriptions contract.
# The browser Web Speech API path needs no STT endpoint at all, so leaving STT
# unset only disables the audio-upload fallback.
AI_STT_ROUTE=v1
AI_TTS_ROUTE=local
AI_LLM_ROUTE=v1

# Provider-specific model IDs. TTS is optional because OmniVoice can resolve its model server-side.
# STT model ID is optional for whisper.cpp, which serves one preloaded model.
AI_STT_MODEL_ID=
AI_TTS_MODEL_ID=
# Optional endpoint overrides for a self-hosted OmniVoice-compatible server.
AI_TTS_ENROLLMENT_PATH=/v1/voice-clones
AI_TTS_STATUS_PATH=/v1/voice-clones
AI_TTS_SYNTHESIS_PATH=/v1/audio/speech
AI_TTS_DELETE_PATH=/v1/voice-clones
AI_LLM_MODEL_ID=

# Optional phoneme/forced-alignment provider; missing path/model means the
# pronunciation UI stays score-free and reports an explicit provider gate.
AI_PRONUNCIATION_ROUTE=v1
AI_PRONUNCIATION_MODEL_ID=
AI_PRONUNCIATION_PATH=
AI_PRONUNCIATION_TIMEOUT_MS=30000

# Server-only Upstash Redis cache. Both values must be set to enable it; leaving
# either blank keeps every read going straight to Firestore. Get them from
# https://console.upstash.com -> your database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to false to disable the cache without unsetting credentials.
CACHE_ENABLED=

# ---------------------------------------------------------------------------
# Production E2E (Playwright) � optional.
# The runner refuses to start unless every key its suite needs is present, and
# it only ever reads apps/web/.env.e2e.production. Never commit real test
# passwords, service-account keys, or provider credentials.
#
# NOTE: several of these hold ordinary words or booleans ("student", "true").
# Netlify's secrets scanner greps the repo for every environment VALUE, so keep
# them OUT of the Netlify build environment, or list them in SECRETS_SCAN_OMIT_KEYS
# in netlify.toml (the repo already omits them there).
# ---------------------------------------------------------------------------
E2E_BASE_URL=https://tuturai-apps.netlify.app
E2E_ALLOW_CUSTOM_NETLIFY_HOST=false
E2E_FIREBASE_PROJECT_ID=
E2E_FIREBASE_ADMIN_PROJECT_ID=
E2E_FIREBASE_ADMIN_CLIENT_EMAIL=
E2E_FIREBASE_ADMIN_PRIVATE_KEY=

# Pre-created, dedicated production E2E accounts.
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_STUDENT_UID=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_TEACHER_UID=
E2E_FOREIGN_TEACHER_EMAIL=
E2E_FOREIGN_TEACHER_PASSWORD=
E2E_FOREIGN_TEACHER_UID=
E2E_TEST_PREFIX=e2e-prod
E2E_TEST_DATA_APPROVED=false
E2E_CLEANUP_AFTER_RUN=true
E2E_HEADLESS=false

# Google auth pauses for a human browser login and resumes assertions after.
E2E_GOOGLE_AUTH_ENABLED=false
E2E_GOOGLE_AUTH_EMAIL=
E2E_GOOGLE_AUTH_ROLE=student
E2E_GOOGLE_AUTH_TEST_ACCOUNT_APPROVED=false

# Existing, dedicated classroom fixtures used by scoped E2E suites.
E2E_CLASSROOM_ID=
E2E_FOREIGN_CLASSROOM_ID=
E2E_REVOKED_JOIN_CLASSROOM_ID=
E2E_REVOKED_JOIN_KEY=

# Enable a provider flag only after that provider is configured in production.
E2E_DRIVE_ENABLED=false
E2E_DRIVE_ACCOUNT_EMAIL=
E2E_DRIVE_ACCOUNT_APPROVED=false
E2E_DRIVE_TEST_FILE=
E2E_AI_ENABLED=false
E2E_AUDIO_FIXTURE_PATH=
E2E_EXPECTED_TEXT=
E2E_PRONUNCIATION_ENABLED=false
E2E_VOICE_ENABLED=false
E2E_VOICE_AUDIO_FIXTURE=
E2E_VOICE_REFERENCE_TEXT=
E2E_OFFLINE_ENABLED=false